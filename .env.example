# Auth.js — segredo para JWT/sessions. Gerar com: openssl rand -base64 32
AUTH_SECRET=

# Trust host (necessário em proxy/cloudflare/produção)
AUTH_TRUST_HOST=true

# Admin único (Fase 3 — antes do SQLite na Fase 4)
ADMIN_EMAIL=admin@agathas.com.br
ADMIN_NAME=Admin
# Gerar hash com: node scripts/hash-password.mjs <senha>
ADMIN_PASSWORD_HASH=

# DeepSeek — tradução automática de posts no painel admin (Fase 5)
# Modelo padrão: deepseek-chat (compatível com API OpenAI). Custo ~10× menor
# que Claude Sonnet. Gerar em https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=

# Cron — autentica /api/cron/publish-scheduled (Bearer token).
# Sem esse valor o endpoint retorna 503. Gerar com: openssl rand -base64 32
CRON_SECRET=

# Google Tag Manager — ID do container (formato GTM-XXXXXX).
# Sem este valor o GTM não é carregado (evita erro de console com placeholder).
NEXT_PUBLIC_GTM_ID=

# IndexNow — protocolo aberto (Bing, Yandex, Naver, Seznam, Yep).
# Pode gerar a key em /admin/settings (DB prioritizada). Sem auth, sem custo.
# Para Google usamos WebSub (sem credencial, ver /admin/settings).
INDEXNOW_KEY=

# ASAAS — checkout de assinaturas (Voyia, Tráfego Pago).
# Painel: https://www.asaas.com (produção) ou https://sandbox.asaas.com (testes).
# Chave em "Configurações → Integrações → Chave API".
# Deixe ASAAS_ENV=sandbox enquanto testa, troque para "production" no go-live.
ASAAS_API_KEY=
ASAAS_ENV=sandbox
# Token enviado pela ASAAS no header `asaas-access-token` nos webhooks.
# Configure o webhook em "Configurações → Integrações → Webhooks" apontando para
# https://<seu-domínio>/api/asaas/webhook
ASAAS_WEBHOOK_TOKEN=

# SMTP — envio de e-mails transacionais (confirmação de pagamento, conta Voyia).
# Em dev, deixe SMTP_HOST vazio → cai no Mailpit do container (nada sai de verdade).
# Em produção, preencha com a caixa noreply@agathasweb.com (testada e funcional):
#   SMTP_HOST=mail.agathasweb.com
#   SMTP_PORT=587  ·  SMTP_SECURE=false (STARTTLS)
#   SMTP_USER=noreply@agathasweb.com  ·  SMTP_PASS=<senha da caixa>
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=noreply@agathasweb.com
SMTP_PASS=
SMTP_FROM=Agathas Web <noreply@agathasweb.com>
# E-mail interno que recebe a notificação de cada nova assinatura paga.
TEAM_NOTIFICATION_EMAIL=webmaster@agathas.com.br

# Redirect pós-pagamento — a ASAAS exige que este domínio esteja cadastrado
# em "Minha Conta → Informações → site". Deixe vazio para desligar o callback
# (em sandbox/localhost o redirect não funciona). Ex.: https://agathas.com.br
ASAAS_CALLBACK_URL=

# Integração com o voyia-dev.
# VOYIA_SIGNUP_URL: página de criação de conta do Voyia (recebe ?token=).
# VOYIA_API_KEY: segredo compartilhado — o voyia-dev envia no header
#   `x-voyia-key` ao chamar /api/asaas/verify-account. Gerar com: openssl rand -base64 32
VOYIA_SIGNUP_URL=https://voyia.com.br/criar-conta
VOYIA_API_KEY=

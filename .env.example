# Auth.js — segredo para JWT/sessions. Gerar com: openssl rand -base64 32
AUTH_SECRET=

# Trust host (necessário em proxy/cloudflare/produção)
AUTH_TRUST_HOST=true

# Admin único (Fase 3 — antes do SQLite na Fase 4)
ADMIN_EMAIL=admin@agathas.com.br
ADMIN_NAME=Admin
# Gerar hash com: node scripts/hash-password.mjs <senha>
ADMIN_PASSWORD_HASH=

# Anthropic Claude — tradução automática de posts no painel admin (Fase 5)
# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
